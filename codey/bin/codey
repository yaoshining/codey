#!/usr/bin/env bash
# Run Pi with Codey's user directory and help display, keeping Pi's runtime identity.
set -euo pipefail

# The explicit T3 alias uses Pi's version for T3's standalone compatibility probe.
if [[ "${0##*/}" == codey-t3 && "$#" -eq 1 && "$1" == --version ]]; then
  set -- --pi-version
fi

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" = /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
REPO_DIR="$(cd -P "$(dirname "$SOURCE")/../.." && pwd)"

if [[ "${1:-}" == sandbox ]]; then
  shift
  unset NODE_OPTIONS NODE_PATH
  exec node "$REPO_DIR/codey/sandbox.mjs" "$@"
fi

HAS_MACOS_SANDBOX=
for ARG in "$@"; do
  case "$ARG" in
    --) break ;;
    --sandbox|--sandbox=*) HAS_MACOS_SANDBOX=1; break ;;
  esac
done
if [[ -n "$HAS_MACOS_SANDBOX" ]]; then
  unset CODEY_SANDBOX_T3
  if [[ "${0##*/}" == codey-t3 ]]; then
    export CODEY_SANDBOX_T3=1
  fi
  unset NODE_OPTIONS NODE_PATH
  RESOLVER_URL="$(node -p 'require("node:url").pathToFileURL(process.argv[1]).href' "$REPO_DIR/packages/coding-agent/src/experimental/source-resolver.ts")"
  exec node --import "$RESOLVER_URL" "$REPO_DIR/codey/sandbox/macos/terminal.mjs" "$@"
fi

# Explicit Codey overrides win; existing Pi overrides remain opt-in shared state.
export PI_CODING_AGENT_DIR="${CODEY_CODING_AGENT_DIR:-${PI_CODING_AGENT_DIR:-$HOME/.codey/agent}}"
if [[ -n "${CODEY_CODING_AGENT_SESSION_DIR:-}" ]]; then
  export PI_CODING_AGENT_SESSION_DIR="$CODEY_CODING_AGENT_SESSION_DIR"
fi

# --import needs a file URL when the checkout path contains #, ? or %.
RESOLVER_URL="$(node -p 'require("node:url").pathToFileURL(process.argv[1]).href' "$REPO_DIR/packages/coding-agent/src/experimental/source-resolver.ts")"
exec node --import "$RESOLVER_URL" "$REPO_DIR/codey/cli.mjs" "$@"
