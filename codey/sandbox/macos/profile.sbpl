; Closed by default. The worker and its child processes use this same profile.
(version 1)
(deny default)
(allow process-fork)
(allow signal (target same-sandbox))
(allow process-info* (target same-sandbox))
(allow sysctl-read
  (sysctl-name-prefix "hw.")
  (sysctl-name "kern.argmax")
  ; libuv's uname() reads the node name with the OS and hardware identifiers.
  (sysctl-name "kern.hostname")
  (sysctl-name "kern.osrelease")
  (sysctl-name "kern.ostype")
  (sysctl-name "kern.osversion")
  (sysctl-name "kern.version")
  (sysctl-name-prefix "kern.proc.pid.")
  (sysctl-name "kern.maxfilesperproc"))
(allow mach-lookup (global-name "com.apple.system.opendirectoryd.libinfo"))
; System runtime probes on macOS. These are not user IPC or filesystem grants.
(allow system-mac-syscall (mac-policy-name "vnguard"))
(allow system-mac-syscall
  (require-all (mac-policy-name "Sandbox") (mac-syscall-number 67)))
(allow file-read-metadata
  (path-ancestors (param "WORKSPACE"))
  (path-ancestors (param "SCRATCH"))
  (path-ancestors (param "INSTALL"))
  (path-ancestors (param "NODE"))
  (literal "/")
  (literal "/System/Volumes")
  (literal "/System/Volumes/Data")
  (literal "/System/Volumes/Data/Users")
  (literal "/dev")
  (literal "/dev/fd"))
(allow file-read* file-map-executable
  (subpath "/System/Library")
  (subpath "/Library/Apple/System/Library")
  (subpath "/Library/Apple/usr/lib")
  ; macOS can locate the signed dyld shared cache on the OS Cryptex.
  (subpath "/System/Volumes/Preboot/Cryptexes/OS/System/Library/dyld")
  (subpath "/private/preboot/Cryptexes/OS/System/Library/dyld")
  (subpath "/System/Cryptexes/OS/System/Library/dyld")
  (subpath (param "DYLD_CACHE"))
  (subpath "/usr/lib")
  (subpath "/usr/bin")
  (subpath "/bin")
  (subpath (param "INSTALL"))
  (literal (param "NODE"))
  (subpath (param "TOOLCHAIN"))
  (subpath (param "TOOLCHAIN_LINKS")))
(allow file-read*
  (literal "/")
  (literal "/System")
  (literal "/System/Volumes/Preboot")
  (literal "/System/Volumes/Preboot/Cryptexes")
  (literal "/System/Volumes/Preboot/Cryptexes/OS")
  (literal "/private/preboot/Cryptexes")
  (literal "/private/preboot")
  (literal "/private/preboot/Cryptexes/OS")
  (literal "/System/Cryptexes")
  (literal "/System/Cryptexes/OS"))
(allow file-read-metadata (path-ancestors (param "DYLD_CACHE")))
(allow process-exec
  (subpath "/usr/bin")
  (subpath "/bin")
  (literal (param "NODE")))
(allow file-read*
  (literal "/dev/null")
  (literal "/dev/urandom")
  (literal "/dev/random")
  (literal "/private/etc/passwd")
  (literal "/private/etc/localtime")
  (subpath "/private/var/db/timezone"))
(allow file-write-data (literal "/dev/null"))
; Only the three inherited pipes are accessible through their descriptor paths.
(allow file-read* (literal "/dev/fd/0") (literal "/dev/fd/1") (literal "/dev/fd/2"))
(allow file-write-data (literal "/dev/fd/1") (literal "/dev/fd/2"))
(allow file-read* file-write* (subpath (param "WORKSPACE")) (subpath (param "SCRATCH")))
; These names stay protected even inside the selected workspace. Explicit
; character classes preserve the restriction on case-insensitive volumes.
(deny file-read* file-write*
  (regex #"/([.][gG][iI][tT](-[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL][sS])?|[.][eE][nN][vV]([.][^/]*|[rR][cC])?|[.][sS][sS][hH]|[.][aA][wW][sS]|[.][gG][nN][uU][pP][gG]|[.][cC][oO][dD][eE][yY]|[.][pP][iI]|[.][kK][uU][bB][eE]|[.][dD][oO][cC][kK][eE][rR]|[.][nN][eE][tT][rR][cC]|[.][nN][pP][mM][rR][cC]|[^/]+[.]([pP][eE][mM]|[kK][eE][yY]|[pP]12)|[iI][dD]_([rR][sS][aA]|[dD][sS][aA]|[eE][cC][dD][sS][aA]|[eE][dD]25519)([.][^/]*)?|[aA][uU][tT][hH][.][jJ][sS][oO][nN]|[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL][sS]([.][jJ][sS][oO][nN])?)(/|$)"))
; No network or general IPC rule is present.
