; Additional rules for the fixed review worker only.
(deny file-write* (subpath (param "WORKSPACE")))
(deny process-exec (subpath "/usr/bin") (subpath "/bin"))
(allow process-exec (literal (param "REVIEW_GIT")) (literal (param "NODE")))
(allow file-read-metadata (path-ancestors (param "REVIEW_GIT")))
(allow file-read* file-map-executable (literal (param "REVIEW_GIT")) (subpath (param "REVIEW_GIT_LIB")))

; Read a local Git directory's index, branch refs and object database. The
; worker uses a separate scratch Git directory with no repository config or hooks.
(define git-dir (param "REVIEW_GIT_DIR"))
(allow file-read-metadata (literal git-dir) (literal (string-append git-dir "/info")))
(allow file-read*
  (literal (string-append git-dir "/HEAD"))
  (literal (string-append git-dir "/index"))
  (literal (string-append git-dir "/packed-refs"))
  (literal (string-append git-dir "/info/exclude"))
  (subpath (string-append git-dir "/refs"))
  (subpath (string-append git-dir "/objects")))
(deny file-read-data
  (literal (string-append git-dir "/objects/info/alternates"))
  (literal (string-append git-dir "/objects/info/http-alternates")))
